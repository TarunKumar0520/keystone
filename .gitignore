# --- Secrets: never commit ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Data ---
# Source documents: keep the folder, not the PDFs (download list is in the README).
data/raw/*
!data/raw/.gitkeep
# Chroma database is generated by the ingestion pipeline; rebuild it, don't commit it.
data/chroma/*
!data/chroma/.gitkeep

# Eval run outputs (Phase 6)
evals/results/

# --- Frontend (Phase 7) ---
node_modules/
dist/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
